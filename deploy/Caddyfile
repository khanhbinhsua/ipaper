# Caddyfile cho iPaper standalone.
# - Nếu APP_DOMAIN là domain: Caddy tự xin HTTPS Let's Encrypt.
# - Nếu APP_DOMAIN là IP: Caddy bind HTTP cổng 80 (Let's Encrypt không cấp cho IP).
# Đặt APP_DOMAIN trong .env.prod.

{$APP_DOMAIN} {
    encode gzip

    # API REST -> backend
    handle /api/* {
        reverse_proxy ipaper_backend:3000
    }

    # WebSocket (thông báo realtime)
    handle /socket.io/* {
        reverse_proxy ipaper_backend:3000
    }

    # File (presigned URL từ S3 storage - SeaweedFS trên cổng 8333)
    handle /ipaper-files/* {
        reverse_proxy ipaper-minio:8333
    }

    # Service worker + manifest: no-cache để PWA update được
    @pwa path /sw.js /workbox-*.js /manifest.webmanifest /firebase-messaging-sw.js
    header @pwa Cache-Control "no-cache, no-store, must-revalidate"

    # Còn lại -> frontend React SPA
    handle {
        reverse_proxy ipaper_frontend:80
    }
}
